# Ché boluda · variables de entorno (copiar a .env.local para desarrollo)
# Sin VITE_SUPABASE_URL la app arranca en «modo de prueba» local.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# npm run vapid (la pública aquí; la privada SOLO en Vercel)
VITE_VAPID_PUBLIC_KEY=

# ── Solo en Vercel (Settings → Environment Variables), nunca en el cliente ──
# SUPABASE_SERVICE_ROLE_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://che-boluda.vercel.app
